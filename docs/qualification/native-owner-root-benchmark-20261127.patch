@@ -0,0 +1,511 @@
+//! Matched owner-root reuse experiment with real authenticated temporary MDBX.
+//! Same 32768-entry cache, two branches and a synchronized late ordinary arrival.
+//! Source builds, payload digests and ownership checks qualify this synthetic workload only.
+const std = @import("std");
+const z = @import("zbuilder");
+const n = @import("native_state");
+const Runtime = @import("native_runtime");
+const Host = @import("native_host");
+const Fixture = @import("native_fixture.zig");
+const f = @import("fixtures");
+const a = std.testing.allocator;
+const io = std.testing.io;
+const slots = 65536;
+const bulk_count = 64;
+const tx_count = bulk_count + 1;
+const writes_per_tx = 128;
+const block_gas = 300_000_000;
+const rlp_bytes = 4 << 20;
+const publication_cutoffs_ms = [_]i96{ 100, 250, 500, 1000 };
+const bulk_code = program();
+fn program() [writes_per_tx * 8 + 1]u8 {
+    var result: [writes_per_tx * 8 + 1]u8 = undefined;
+    for (0..writes_per_tx) |i| {
+        // SSTORE(start+i, 42). Each transaction supplies its first slot in calldata.
+        const instruction = [_]u8{ 0x60, 42, 0x60, @intCast(i), 0x5f, 0x35, 0x01, 0x55 };
+        @memcpy(result[i * 8 ..][0..8], &instruction);
+    }
+    result[result.len - 1] = 0;
+    return result;
+}
+fn clock() i96 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+fn cpu() i96 {
+    return std.Io.Clock.cpu_process.now(io).toNanoseconds();
+}
+fn millis() i64 {
+    return @intCast(@divFloor(clock(), std.time.ns_per_ms));
+}
+fn emit(value: anytype) !void {
+    const bytes = try std.json.Stringify.valueAlloc(a, value, .{});
+    defer a.free(bytes);
+    std.debug.print("native_cache_capacity {s}\n", .{bytes});
+}
+fn digest(output: z.payload.Output) ![32]u8 {
+    const bytes = try std.json.Stringify.valueAlloc(a, output, .{});
+    defer a.free(bytes);
+    return z.zevm.crypto.hash.keccak256(bytes);
+}
+const Env = struct {
+    fixture: Fixture,
+    eth: n.Eth,
+    snapshots: n.Snapshots,
+    reader: n.Reader,
+    prepare_ns: i96,
+    fn create() !*Env {
+        const started = clock();
+        const self = try a.create(Env);
+        errdefer a.destroy(self);
+        self.fixture = try Fixture.init();
+        errdefer self.fixture.deinit();
+        try self.fixture.write(0);
+        self.eth = n.Eth.init(&self.fixture.store);
+        {
+            var arena: std.heap.ArenaAllocator = .init(a);
+            defer arena.deinit();
+            const alloc = arena.allocator();
+            const txn = try self.fixture.store.transaction_rw();
+            errdefer txn.abort() catch unreachable;
+            const keys = try alloc.alloc([32]u8, slots);
+            const values = try alloc.alloc(u256, slots);
+            for (keys, values, 0..) |*key, *value, i| {
+                key.* = n.types.keccakOfU256(i);
+                value.* = 17;
+            }
+            // A fresh trie hashes completed elder siblings during insertion;
+            // use its sorted-key bulk contract before any resolver exists.
+            std.mem.sortUnstable([32]u8, keys, {}, struct {
+                fn less(_: void, left: [32]u8, right: [32]u8) bool {
+                    return std.mem.order(u8, &left, &right) == .lt;
+                }
+            }.less);
+            var storage_nodes = try n.trie.NodeCollector.init(alloc, 262144);
+            var storage = n.StorageTrie.init(alloc).withCollector(&storage_nodes);
+            try storage.update(keys, values);
+            const writer_hash = n.types.keccakOfU160(f.writer);
+            var account = (try self.eth.readAccount(txn, writer_hash)).?;
+            account.storage_hash = try storage.rootHash();
+            account.code_hash = try self.eth.writeCode(txn, &bulk_code);
+            try self.eth.commitStorageTrieNodes(txn, writer_hash, &storage_nodes);
+            for (keys, values) |key, value| try self.eth.writeStorage(txn, writer_hash, key, value);
+            var account_nodes = try n.trie.NodeCollector.init(alloc, 1024);
+            {
+                var accounts = try self.eth.openAccountTrie(alloc, txn, self.fixture.header.state_root);
+                defer self.eth.closeAccountTrie(&accounts);
+                accounts.inner = accounts.inner.withCollector(&account_nodes);
+                // Resolve the old account leaf before replacing the flat account.
+                try accounts.updateNoDeletions(&.{writer_hash}, &.{account});
+                self.fixture.header.state_root = try accounts.rootHash();
+            }
+            try self.eth.commitAccountTrieNodes(txn, &account_nodes);
+            try self.eth.writeAccount(alloc, txn, writer_hash, account);
