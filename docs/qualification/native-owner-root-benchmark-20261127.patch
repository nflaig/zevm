index 0000000..19beb68
--- /dev/null
+++ b/scripts/native_owner_root_benchmark.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""Run already-built matched native-owner test binaries in a recorded ABBA order.
+
+The fixture itself asserts successful execution, cache saturation and retained
+payload ownership. This driver additionally compares complete emitted payload
+and receipt bytes across both binaries, and separates a fixed-work schedule from
+the deployed owner's elapsed-time-dependent schedule. It never opens a live DB.
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import time
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def now():
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+def environment():
+    result = {"utc": now(), "loadAverage": os.getloadavg(), "cpuCount": os.cpu_count()}
+    files = [Path("/proc/loadavg"), Path("/proc/self/cgroup")]
+    files += [Path("/proc/pressure") / item for item in ("cpu", "io", "memory")]
+    try:
+        group = next(line[3:] for line in Path("/proc/self/cgroup").read_text().splitlines() if line.startswith("0::"))
+        base = Path("/sys/fs/cgroup") / group.lstrip("/")
+        files += [base / item for item in ("cpu.stat", "cpu.max", "memory.current", "memory.max")]
+    except (OSError, StopIteration):
+        pass
+    result["files"] = {}
+    for path in files:
+        try:
+            result["files"][str(path)] = path.read_text()
+        except OSError as exc:
+            result["files"][str(path)] = {"unavailable": str(exc)}
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--control", required=True, type=Path)
+    parser.add_argument("--treatment", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--timeout", type=float, default=900)
+    parser.add_argument("--order", choices=("ABBA", "BAAB"), default="ABBA", help="A=control, B=treatment")
+    args = parser.parse_args()
+    binaries = {arm: getattr(args, arm).resolve(strict=True) for arm in ("control", "treatment")}
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    record = {"startedUtc": now(), "orderName": args.order, "order": [{"A": "control", "B": "treatment"}[letter] for letter in args.order],
+              "binaries": {arm: {"path": str(path), "sha256": sha(path)} for arm, path in binaries.items()},
+              "driverSha256": sha(Path(__file__)), "runs": [], "qualified": False}
+    (output / "manifest.json").write_text(json.dumps(record, indent=2) + "\n")
+    payloads = {}
+    workload = None
+    fixed_counts = None
+    fixed_cache_stats = None
+    for index, arm in enumerate(record["order"]):
+        name = f"{index}-{arm}"
+        log = output / (name + ".log")
+        usage = output / (name + ".usage.json")
+        command = ["/usr/bin/time", "-f", '{"maxRssKiB":%M,"userSeconds":%U,"systemSeconds":%S,"elapsedSeconds":%e,"exitCode":%x}',
+                   "-o", str(usage), str(binaries[arm])]
+        started = time.monotonic()
+        run = {"arm": arm, "index": index, "command": command, "startedUtc": now(), "before": environment()}
+        with log.open("xb") as stream, (output / (name + ".noise.jsonl")).open("x") as noise:
+            child = subprocess.Popen(command, stdout=stream, stderr=subprocess.STDOUT, start_new_session=True)
+            while child.poll() is None:
+                noise.write(json.dumps(environment()) + "\n")
+                noise.flush()
+                if time.monotonic() - started > args.timeout:
+                    os.killpg(child.pid, signal.SIGTERM)
+                    try:
+                        child.wait(timeout=10)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(child.pid, signal.SIGKILL)
+                        child.wait()
+                    run["timedOut"] = True
+                    break
+                try:
+                    child.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    pass
+        run.update(exitCode=child.returncode, finishedUtc=now(), elapsedSeconds=time.monotonic() - started,
+                   logSha256=sha(log), after=environment())
+        if usage.exists():
+            run["processUsage"] = json.loads(usage.read_text().splitlines()[-1])
+        run["samples"] = []
+        for line in log.read_bytes().splitlines():
+            marker = b"native_cache_capacity "
+            if marker not in line:
+                continue
+            raw = line.split(marker, 1)[1]
+            item = json.loads(raw)
+            if item["kind"] == "owner_root_payload":
+                key = item["schedule"]
+                artifact = output / (name + "-" + key + "-payload.json")
+                artifact.write_bytes(raw + b"\n")
+                if key in payloads:
+                    assert raw == payloads[key], f"complete payload/receipt byte mismatch: {name}/{key}"
+                else:
+                    payloads[key] = raw
+                run.setdefault("payloads", {})[key] = {"path": artifact.name, "sha256": sha(artifact)}
+            elif item["kind"] == "owner_root":
+                identity = [item[k] for k in ("parent", "rawHash", "payloadHashes", "bulkTransactions", "transactions", "writesPerTransaction")]
+                if workload is None:
+                    workload = identity
+                assert identity == workload, f"different input/final payload: {name}"
+                if item["schedule"] == "fixed_work":
+                    counts = [item["ticks"], item["attempts"], item["sealsByBranch"],
+                              [{k: m["native"][k] for k in ("account_reads", "storage_reads", "code_reads", "node_reads", "node_bytes", "seal_calls", "append_calls", "transaction_attempts")} for m in item["finalMetrics"]]]
+                    if fixed_counts is None:
+                        fixed_counts = counts
+                    assert counts == fixed_counts, f"fixed work changed: {name}"
+                    stats = [m["node_cache"] for m in item["finalMetrics"]]
+                    comparable = [{k: value for k, value in stat.items() if k != "owner_reads"} for stat in stats]
+                    if fixed_cache_stats is None:
+                        fixed_cache_stats = comparable
+                    assert comparable == fixed_cache_stats, f"cache semantics changed: {name}"
+                    for stat in stats:
+                        if arm == "control":
+                            assert stat["owner_reads"] == stat["fallback_reads"] > 0, f"control fallback path not exercised: {name}"
+                        else:
+                            assert stat["owner_reads"] == 0 and stat["fallback_reads"] > 0, f"treatment owner-root reuse not exercised: {name}"
+                run["samples"].append(item)
+        record["runs"].append(run)
+        (output / "manifest.json").write_text(json.dumps(record, indent=2) + "\n")
+        assert child.returncode == 0, f"test failed: {log}"
+        assert len(run["samples"]) == 6 and len(run.get("payloads", {})) == 2, f"incomplete fixture output: {name}"
+        assert sha(binaries[arm]) == record["binaries"][arm]["sha256"], "binary changed while running"
+        print(json.dumps({"run": name, "exitCode": child.returncode, "elapsedSeconds": run["elapsedSeconds"]}), flush=True)
+    assert json.loads(payloads["fixed_work"])["primary"] == json.loads(payloads["deployed_owner"])["primary"]
+    assert json.loads(payloads["fixed_work"])["secondary"] == json.loads(payloads["deployed_owner"])["secondary"]
+    record.update(qualified=True, finishedUtc=now(), literalPayloadAndReceiptEquality=True, fixedWorkEqual=True,
+                  limits="Synthetic local matched workload only; no live or Prepared/gossip latency claim. The deployed-owner schedule has variable intermediate seals; fixed-work isolates equal sealing work. Warmups remain recorded and must be excluded from summary estimates.")
+    (output / "manifest.json").write_text(json.dumps(record, indent=2) + "\n")
+    print(json.dumps({"qualified": True, "output": str(output)}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
